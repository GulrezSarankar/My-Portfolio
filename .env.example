# Supabase Client Environment Variables
# Copy this file to .env or .env.local and populate with your credentials.
# Do NOT commit real credentials or keys to version control.

# Supabase Project URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://njmzejtlmokfjpzjkcrq.supabase.co

# Supabase Publishable / Anon Key (safe to use in browser)
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# Optional: React Scripts compatibility fallback (if running in CRA environment)
REACT_APP_SUPABASE_URL=https://njmzejtlmokfjpzjkcrq.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

